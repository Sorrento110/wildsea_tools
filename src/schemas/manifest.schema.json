{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wildsea-tools.local/schemas/manifest.schema.json",
  "title": "Tool manifest",
  "description": "Registry of available generator tools rendered on the landing page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "tools"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/tool" }
    }
  },
  "definitions": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "route", "description", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1, "pattern": "^/" },
        "description": { "type": "string", "minLength": 1 },
        "dataDir": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "planned"] }
      }
    }
  }
}
