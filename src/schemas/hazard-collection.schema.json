{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wildsea-tools/hazard-collection.schema.json",
  "title": "Hazard collection",
  "type": "object",
  "required": ["tool", "collection", "title", "category", "hazards"],
  "properties": {
    "$schema": { "type": "string" },
    "tool": { "const": "hazards" },
    "collection": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "order": { "type": "number" },
    "source": { "type": "string" },
    "inPlay": { "type": "string" },
    "basic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hazards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "size", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "size": {
            "enum": ["Variable", "Small", "Medium", "Large", "Huge", "Swarm", "Various", "Leviathan", "Illness"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "source": { "type": "string" }
        }
      }
    }
  }
}
