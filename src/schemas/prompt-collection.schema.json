{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wildsea-tools.local/schemas/prompt-collection.schema.json",
  "title": "Prompt collection",
  "description": "A data-driven collection of random prompts grouped into d6 outcomes. Used by the Watch Results and Weather tools.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "collection", "title", "outcomes"],
  "properties": {
    "$schema": { "type": "string" },
    "tool": { "type": "string", "minLength": 1 },
    "collection": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source": { "type": "string" },
    "order": { "type": "integer", "minimum": 0 },
    "rollLabel": { "type": "string", "minLength": 1 },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/outcome" }
    }
  },
  "definitions": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "rolls", "prompts"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "rolls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 6 }
        },
        "description": { "type": "string" },
        "prompts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/prompt" }
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "roll": { "type": "integer", "minimum": 1, "maximum": 6 },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
