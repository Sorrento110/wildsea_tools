---
import BaseLayout from '../layouts/BaseLayout.astro';
import manifest from '../data/manifest.json';
import { baseUrl } from '../lib/base-url';
import { loadShipCollections } from '../lib/ship-data';
import { loadPromptCollections } from '../lib/prompt-data';
import { loadPoiDataset } from '../lib/poi-data';
import { loadHazardCollections } from '../lib/hazard-data';
import type { ToolManifest } from '../lib/types';

const data = manifest as ToolManifest;
const base = baseUrl();

const shipCollections = loadShipCollections();
const shipCollectionsJson = JSON.stringify(shipCollections);

const journeySources = {
  watch: loadPromptCollections('watch-results'),
  weather: loadPromptCollections('weather-conditions'),
  poi: loadPoiDataset(),
  hazards: loadHazardCollections(),
};
const journeySourcesJson = JSON.stringify(journeySources);
---

<BaseLayout title={data.title} description={data.description}>
  <section class="hero">
    <p class="hero-eyebrow">For the rustling waves</p>
    <h1>{data.title}</h1>
    <p class="hero-lede">{data.description}</p>
  </section>

  <section class="quick-access" aria-labelledby="quick-access-heading">
    <header class="section-heading">
      <h2 id="quick-access-heading">Quick Sparks</h2>
      <p>Roll inspiration without leaving the table.</p>
    </header>

    <div class="quick-actions">
      <button type="button" id="quick-generate-journey" class="quick-tile">
        <span class="quick-tile-glyph" aria-hidden="true">🧭</span>
        <span class="quick-tile-text">
          <span class="quick-tile-title">Roll a Journey Leg</span>
          <span class="quick-tile-hint">Watch, weather, landing, and hazard at once</span>
        </span>
      </button>
      <button type="button" id="quick-generate-ship" class="quick-tile">
        <span class="quick-tile-glyph" aria-hidden="true">⚓</span>
        <span class="quick-tile-text">
          <span class="quick-tile-title">Generate Ship</span>
          <span class="quick-tile-hint">Random NPC ship at a glance</span>
        </span>
      </button>
    </div>

    <div id="quick-result" class="quick-result" aria-live="polite"></div>
    <div id="quick-journey-result" class="quick-result" aria-live="polite"></div>
  </section>

  <section class="tools" aria-labelledby="tools-heading">
    <header class="section-heading">
      <h2 id="tools-heading">Tools</h2>
      <p>The collection grows with the canopy.</p>
    </header>

    <div class="tool-grid">
      {
        data.tools.map((tool) => (
          <a class="tool-card" href={`${base}${tool.route.replace(/^\//, '')}`}>
            <h2>{tool.name}</h2>
            <p>{tool.description}</p>
            <span class="tool-card-action">Open tool <span aria-hidden="true">→</span></span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<div id="quick-ship-data" hidden data-collections={shipCollectionsJson} data-base={base}></div>
<div id="quick-journey-data" hidden data-sources={journeySourcesJson} data-base={base}></div>

<script>
  import { generateShip } from '../lib/ship-generator';
  import { renderShipQuickHtml, formatShipText } from '../lib/ship-render';
  import { copyWithFeedback } from '../lib/clipboard';
  import type { GeneratedShip } from '../lib/types';

  const dataEl = document.getElementById('quick-ship-data');
  const collections = JSON.parse(dataEl?.dataset.collections ?? '{}');
  const baseUrl = dataEl?.dataset.base ?? '/';
  const shipDetailBaseUrl = `${baseUrl}tools/ships/`;

  const button = document.getElementById('quick-generate-ship');
  const result = document.getElementById('quick-result');

  let latestShip: GeneratedShip | null = null;
  let rollCount = 0;

  function latest() {
    latestShip = generateShip(collections);
    rollCount += 1;
    return latestShip;
  }

  button?.addEventListener('click', () => {
    const ship = latest();
    if (!result) return;

    result.innerHTML = `
      <details class="quick-details" open>
        <summary>
          <span class="quick-details-title">Ship ${rollCount}</span>
          <span class="quick-details-chevron" aria-hidden="true">▾</span>
        </summary>
        <div class="quick-details-body">${renderShipQuickHtml(ship, { detailBaseUrl: shipDetailBaseUrl })}</div>
        <div class="quick-details-footer">
          <button type="button" class="secondary-button" data-copy-quick>Copy</button>
        </div>
      </details>
    `;
  });

  result?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const copyButton = target.closest('button[data-copy-quick]');
    if (!copyButton || !latestShip) return;
    void copyWithFeedback(copyButton, formatShipText(latestShip));
  });
</script>

<script>
  import { generateJourneyLeg } from '../lib/journey-generator';
  import { renderJourneyQuickHtml, formatJourneyText } from '../lib/journey-render';
  import { copyWithFeedback } from '../lib/clipboard';
  import type { GeneratedJourneyLeg, JourneySources } from '../lib/types';

  const journeyDataEl = document.getElementById('quick-journey-data');
  const journeySources = JSON.parse(journeyDataEl?.dataset.sources ?? '{}') as JourneySources;
  const journeyBaseUrl = `${journeyDataEl?.dataset.base ?? '/'}tools/journey/`;

  const journeyButton = document.getElementById('quick-generate-journey');
  const journeyResult = document.getElementById('quick-journey-result');

  let latestLeg: GeneratedJourneyLeg | null = null;
  let journeyCount = 0;

  journeyButton?.addEventListener('click', () => {
    latestLeg = generateJourneyLeg(journeySources);
    journeyCount += 1;
    if (!journeyResult) return;

    journeyResult.innerHTML = `
      <details class="quick-details" open>
        <summary>
          <span class="quick-details-title">Journey leg ${journeyCount}</span>
          <span class="quick-details-chevron" aria-hidden="true">▾</span>
        </summary>
        <div class="quick-details-body">${renderJourneyQuickHtml(latestLeg)}</div>
        <div class="quick-details-footer">
          <a class="secondary-button" href="${journeyBaseUrl}">Open dashboard</a>
          <button type="button" class="secondary-button" data-copy-journey>Copy</button>
        </div>
      </details>
    `;
  });

  journeyResult?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const copyButton = target.closest('button[data-copy-journey]');
    if (!copyButton || !latestLeg) return;
    void copyWithFeedback(copyButton, formatJourneyText(latestLeg));
  });
</script>